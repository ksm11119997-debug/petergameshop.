<!DOCTYPE html>
<html lang="my">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PETER GAME SHOP - MLBB Diamond Top-Up</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Padauk:wght@400;700&family=Rajdhani:wght@500;600;700&display=swap');
    body {
      font-family: 'Rajdhani', 'Padauk', sans-serif;
      background-color: #0b0d14;
      color: #e2e8f0;
    }
    .neon-border {
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.25);
    }
    .neon-border-purple {
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.25);
    }
    .glass-panel {
      background: rgba(18, 24, 38, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-32">

  <!-- Header Banner Image -->
  <div class="w-full bg-black flex justify-center items-center border-b border-cyan-500/30 overflow-hidden">
    <img src="https://lh3.googleusercontent.com/gg/AEmxVGdQW94kE_tK6-GjZ4Jb5p9X-Z5b-J7T5g1Z" alt="PETER GAME SHOP Banner" class="w-full max-h-72 object-cover object-center max-w-6xl">
  </div>

  <!-- Header / Navigation -->
  <header class="sticky top-0 z-40 glass-panel border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      
      <!-- Logo & Stacked Title -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-purple-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
          <i class="fa-solid fa-gamepad text-xl text-white"></i>
        </div>
        <div class="leading-none">
          <span class="block text-xl font-extrabold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400 italic">PETER</span>
          <span class="block text-sm font-bold tracking-widest text-cyan-400">GAME SHOP</span>
        </div>
      </div>

      <!-- Right User Controls -->
      <div class="flex items-center space-x-3">
        <div class="hidden sm:flex flex-col items-end mr-2">
          <span class="text-xs text-slate-400">Wallet Balance</span>
          <span class="text-sm font-bold text-emerald-400" id="userBalanceText">0 MMK</span>
        </div>
        
        <button onclick="openDepositModal()" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/50 text-emerald-300 text-xs font-bold flex items-center space-x-1 transition">
          <i class="fa-solid fa-wallet"></i>
          <span>+ Deposit</span>
        </button>

        <button onclick="toggleAdminPanel()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-semibold">
          <i class="fa-solid fa-user-shield mr-1"></i> Admin
        </button>
      </div>

    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-6xl mx-auto px-4 py-6 flex-1 w-full space-y-6">

    <!-- Account Details Form -->
    <section class="glass-panel p-5 rounded-2xl border border-cyan-500/20 neon-border">
      <h2 class="text-lg font-bold text-cyan-400 mb-3 flex items-center">
        <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center mr-2 border border-cyan-500/40">1</span>
        Account Info
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">User ID</label>
          <input type="number" id="userIdInput" placeholder="e.g. 12345678" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">Zone ID</label>
          <input type="number" id="zoneIdInput" placeholder="e.g. 1234" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-4 py-2.5 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition">
        </div>
      </div>
    </section>

    <!-- Diamond Packages Grid -->
    <section class="glass-panel p-5 rounded-2xl border border-purple-500/20 neon-border-purple">
      <h2 class="text-lg font-bold text-purple-400 mb-3 flex items-center">
        <span class="w-6 h-6 rounded-full bg-purple-500/20 text-purple-400 text-xs flex items-center justify-center mr-2 border border-purple-500/40">2</span>
        Select Diamond Package
      </h2>
      
      <div id="packageGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        <!-- JavaScript will populate packages here -->
      </div>
    </section>

    <!-- Payment & Direct Checkout -->
    <section class="glass-panel p-5 rounded-2xl border border-slate-700">
      <h2 class="text-lg font-bold text-emerald-400 mb-3 flex items-center">
        <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 text-xs flex items-center justify-center mr-2 border border-emerald-500/40">3</span>
        Payment Method
      </h2>

      <!-- Payment Tabs -->
      <div class="grid grid-cols-3 gap-2 mb-4">
        <button onclick="selectPaymentMethod('kpay')" id="tab-kpay" class="pay-tab py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-xs font-bold text-slate-300 hover:border-cyan-500 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-mobile-screen text-base text-cyan-400 mb-1"></i>
          KBZPay
        </button>
        <button onclick="selectPaymentMethod('wave')" id="tab-wave" class="pay-tab py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-xs font-bold text-slate-300 hover:border-yellow-500 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-wallet text-base text-yellow-400 mb-1"></i>
          WavePay
        </button>
        <button onclick="selectPaymentMethod('wallet')" id="tab-wallet" class="pay-tab py-2.5 rounded-xl border border-slate-700 bg-slate-800 text-xs font-bold text-slate-300 hover:border-emerald-500 transition flex flex-col items-center justify-center">
          <i class="fa-solid fa-coins text-base text-emerald-400 mb-1"></i>
          In-App Wallet
        </button>
      </div>

      <!-- Payment Details Info -->
      <div id="paymentDetails" class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 mb-4 space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-400">Account Name:</span>
          <span class="font-bold text-slate-200">PETER GAME SHOP</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-400">Phone Number:</span>
          <div class="flex items-center space-x-2">
            <span id="paymentPhoneText" class="font-bold text-cyan-400">09777111024</span>
            <button onclick="copyNumber()" class="text-slate-400 hover:text-white"><i class="fa-regular fa-copy"></i></button>
          </div>
        </div>
        <div id="txnInputGroup">
          <label class="block text-xs font-medium text-slate-400 mb-1">Transaction Last 6 Digits (Txn ID)</label>
          <input type="text" id="txnIdInput" placeholder="e.g. 987654" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:border-cyan-500">
        </div>
      </div>

      <button onclick="submitOrder()" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 via-indigo-500 to-purple-600 font-bold text-white shadow-lg shadow-cyan-500/20 hover:opacity-95 transition flex items-center justify-center space-x-2">
        <i class="fa-solid fa-bolt"></i>
        <span>Confirm & Buy Now</span>
      </button>
    </section>

  </main>

  <!-- Telegram Support Floating Button -->
  <a href="https://t.me/k3p_sanji007" target="_blank" class="fixed bottom-6 right-6 z-50 flex items-center space-x-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold px-4 py-3 rounded-full shadow-xl shadow-cyan-500/40 transition-all hover:scale-105">
    <i class="fa-brands fa-telegram text-2xl"></i>
    <span class="text-xs">Support Chat</span>
  </a>

  <!-- JS Logic Code -->
  <script>
    const packages = [
      { id: 1, name: "11 Diamonds", price: 600, bonus: 0 },
      { id: 2, name: "14 Diamonds", price: 800, bonus: 1 },
      { id: 3, name: "42 Diamonds", price: 2200, bonus: 4 },
      { id: 4, name: "70 Diamonds", price: 3600, bonus: 7 },
      { id: 5, name: "86 Diamonds", price: 4200, bonus: 8 },
      { id: 6, name: "172 Diamonds", price: 8300, bonus: 16 },
      { id: 7, name: "257 Diamonds", price: 12200, bonus: 24 },
      { id: 8, name: "344 Diamonds", price: 16500, bonus: 38 },
      { id: 9, name: "514 Diamonds", price: 24500, bonus: 64 },
      { id: 10, name: "706 Diamonds", price: 33000, bonus: 98 },
      { id: 11, name: "Weekly Diamond Pass", price: 5400, popular: true },
      { id: 12, name: "Twilight Pass", price: 31000 }
    ];

    let selectedPackageId = 1;
    let selectedPayment = 'kpay';

    function renderPackages() {
      const container = document.getElementById('packageGrid');
      container.innerHTML = packages.map(pkg => `
        <div onclick="selectPackage(${pkg.id})" class="cursor-pointer relative p-3.5 rounded-xl border transition-all ${selectedPackageId === pkg.id ? 'border-cyan-400 bg-cyan-950/40 neon-border' : 'border-slate-800 bg-slate-900/60 hover:border-slate-700'}">
          ${pkg.popular ? '<span class="absolute -top-2 right-2 bg-gradient-to-r from-cyan-500 to-blue-500 text-black font-extrabold text-[9px] px-2 py-0.5 rounded-full uppercase">Best</span>' : ''}
          <div class="flex items-center space-x-2 mb-2">
            <i class="fa-solid fa-gem text-cyan-400 text-sm"></i>
            <span class="font-bold text-xs text-slate-100">${pkg.name}</span>
          </div>
          <div class="text-xs font-extrabold text-amber-400">${pkg.price.toLocaleString()} MMK</div>
        </div>
      `).join('');
    }

    function selectPackage(id) {
      selectedPackageId = id;
      renderPackages();
    }

    function selectPaymentMethod(method) {
      selectedPayment = method;
      const phoneText = document.getElementById('paymentPhoneText');
      const txnGroup = document.getElementById('txnInputGroup');

      if (method === 'kpay') {
        phoneText.innerText = '09777111024';
        txnGroup.style.display = 'block';
      } else if (method === 'wave') {
        phoneText.innerText = '09663422160';
        txnGroup.style.display = 'block';
      } else {
        phoneText.innerText = 'In-App Wallet Balance';
        txnGroup.style.display = 'none';
      }
    }

    function copyNumber() {
      const text = document.getElementById('paymentPhoneText').innerText;
      navigator.clipboard.writeText(text);
      alert('Copied to clipboard: ' + text);
    }

    function submitOrder() {
      const userId = document.getElementById('userIdInput').value;
      const zoneId = document.getElementById('zoneIdInput').value;

      if (!userId || !zoneId) {
        alert('ကျေးဇူးပြု၍ User ID နှင့် Zone ID ထည့်သွင်းပေးပါ။');
        return;
      }
      alert('Order အောင်မြင်စွာ တင်ပြီးပါပြီ။ ခေတ္တစောင့်ဆိုင်းပေးပါ။');
    }

    renderPackages();
  </script>
</body>
</html>
